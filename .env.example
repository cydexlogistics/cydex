# Copy to .env and fill in: cp .env.example .env
# Vite only reads .env at startup: restart `npm run dev` after editing.
# NOTE: every VITE_* value is bundled into the browser JS and is publicly readable.
# Never put a secret here (Squad secret key, Supabase service_role key, VAPID private key, Brevo key):
# those are Supabase function secrets only (`npx supabase secrets set NAME=value`).

# --- Supabase (required: the app won't start without these) ---
# URL: https://<project-ref>.supabase.co (ref is in the dashboard URL, or use the Connect button)
# Key: Project Settings -> API Keys -> anon public (legacy) or publishable
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google Maps (address search + map pin) ---
# Google Cloud console -> APIs & Services -> Credentials -> API key.
# Enable: Places API (New), Maps JavaScript API, Geocoding API.
# Restrict the key to your site URLs (e.g. http://localhost:8080/*) and those 3 APIs.
VITE_GOOGLE_MAPS_API_KEY=

# --- Push notifications (Web Push) ---
# Generate a pair with: npx web-push generate-vapid-keys
# The public key goes here; the private key is ONLY a Supabase function secret:
#   npx supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@your-domain
VITE_VAPID_PUBLIC_KEY=

# Squad (payments, withdrawals, virtual accounts) runs only in Supabase Edge Functions.
# Its keys are function secrets, not app settings:
#   npx supabase secrets set SQUAD_SECRET_KEY=... SQUAD_API_URL=... SQUAD_MERCHANT_ID=... APP_URL=...
